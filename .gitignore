# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
bin/
demo
/seed-sample-data
/loadgen
/nats-debug
# `go build ./...` run from inside a service dir writes the executable there
/search-sync-worker/search-sync-worker
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env files (Vite picks up .env.local automatically; never commit)
.env
.env.local
.env.*.local

# Build output
bin/

# Editor/IDE
# .idea/
# .vscode/
bin/

# Superpowers brainstorming artifacts
.superpowers/

# Git worktrees (local development, isolated branches)
.worktrees/

# Frontend
node_modules/
chat-frontend/dist/
admin-frontend/dist/

# Vitest cache (created when vitest is run from a non-package directory)
.vite/
chat-frontend/.vite/
admin-frontend/.vite/

# Vitest junit reporter output (CI artifact, not source)
chat-frontend/junit.xml
admin-frontend/junit.xml

# Local-only verification cache (tools/buildcache).
.cache/

# Localized documentation mirrors (English files under docs/ are authoritative).
/.local-docs/

# air live-reload tmp artifacts.
tmp/
.air.*.toml
/loadgen
.claude/worktrees/

# stray local builds of the data-migration services
/oplog-connector
/oplog-transformer
/oplog-collections-transformer

# Captured pprof profiles from `make profile`.
profiles/

# Python bytecode from tools/dashboards
__pycache__/
*.pyc
