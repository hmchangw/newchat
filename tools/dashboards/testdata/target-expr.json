{
  "_expect": [
    "target-double-escaped",
    "target-hardcoded-range",
    "target-counter-not-aggregated"
  ],
  "uid": "fixture",
  "title": "fixture",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "Errors",
      "description": "why this panel exists",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (class) (label_replace(rate(x_total[5m]), \"class\", \"$1xx\", \"code\", \"(\\\\d)\\\\d\\\\d\"))",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (y_total{job=\"a\"})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
