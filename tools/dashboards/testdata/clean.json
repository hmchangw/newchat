{
  "_expect": [],
  "uid": "fixture",
  "title": "fixture",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "Request rate",
      "description": "why this panel exists",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO DATA"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "id": 2,
      "title": "Routes",
      "description": "why this panel exists",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_join(sum by (service_name, http_route) (rate(x_total[$__rate_interval])), \"endpoint\", \" | \", \"service_name\", \"http_route\")",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (endpoint) (label_join(sum by (service_name, http_route) (rate(y_total[$__rate_interval])), \"endpoint\", \" | \", \"service_name\", \"http_route\"))",
          "refId": "B",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO DATA"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "req/s"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "req/s",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "endpoint",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "endpoint": true
            },
            "renameByName": {
              "service_name": "service",
              "http_route": "route",
              "Value #A": "req/s",
              "Value #B": "err/s"
            },
            "indexByName": {
              "service_name": 0,
              "http_route": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Time": 4,
              "Time 1": 5,
              "endpoint": 6
            }
          }
        }
      ]
    }
  ]
}
