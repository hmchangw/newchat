  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Consumer loop status (chat_nats_consumer_loop_up)",
      "description": "1 = loop alive and receiving; 0 = consumer loop DOWN (nothing being consumed). Any 0 here is page-worthy. NOTE: loop_up=0 catches a graceful loop failure; a hard process crash removes the series entirely (it can't emit 0), so pair this with absent(chat_nats_consumer_loop_up) or the Prometheus scrape `up==0` to catch a dead process.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chat_nats_consumer_loop_up",
          "legendFormat": "{{service_name}} \u00b7 {{consumer}} \u00b7 {{stream}}/{{site}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Silent drops \u2014 max_deliver exhaustion (per consumer)",
      "description": "increase() of terminal failures with reason=max_deliver: messages that exhausted retries and were DROPPED (no DLQ). Any non-zero value = data-loss-adjacent \u2014 this is the signal the JetStream num_redelivered gauge hides.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, consumer, stream, site) (increase(chat_nats_terminal_failures_total{reason=\"max_deliver\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} \u00b7 {{consumer}} \u00b7 {{stream}}/{{site}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Terminal failures by reason (rate)",
      "description": "rate() of chat_nats_terminal_failures_total across every reason (max_deliver / permanent / publish_exhausted / stream_unavailable / invalid_payload / catch-all). Where work stops getting further attempts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(chat_nats_terminal_failures_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Redelivery rate (chat_nats_consumer_redeliveries_total)",
      "description": "rate() of the cumulative redelivery counter per consumer \u2014 the historical companion to the point-in-time jetstream num_redelivered gauge. Sustained non-zero = a failing/naking handler.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, consumer, stream, site) (rate(chat_nats_consumer_redeliveries_total[$__rate_interval]))",
          "legendFormat": "{{service_name}} \u00b7 {{consumer}} \u00b7 {{stream}}/{{site}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer disposition mix (rate by outcome)",
      "description": "rate() of chat_nats_consumer_messages_total by outcome (ack / nak / term / left_pending / handler_cancelled). A rising nak/term share precedes a backlog.",
      "datasource": {
        "type": "prometheus",
