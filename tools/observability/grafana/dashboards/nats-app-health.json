  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Consumer loop status (chat_nats_consumer_loop_up)",
      "description": "1 = loop alive and receiving; 0 = consumer loop exited gracefully (nothing being consumed). A hard process crash CANNOT emit 0 \u2014 the series goes stale then disappears, so this gauge alone reports a crashed consumer as green. Use the companion 'Scrape health' panel (up==0) / absent(chat_nats_consumer_loop_up) to catch a crash.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chat_nats_consumer_loop_up",
          "legendFormat": "{{service_name}} \u00b7 {{consumer}} \u00b7 {{stream}}/{{site}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Retry-exhausted (max_deliver) \u2014 consumer stops delivering (per consumer)",
      "description": "increase() of terminal failures with reason=max_deliver: messages that exhausted retries. JetStream STOPS delivering them to this consumer (an advisory fires); they remain in the stream until retention \u2014 recoverable via replay, but no handler processed them and no DLQ auto-routes them. Any non-zero value = unprocessed work the num_redelivered gauge hides.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, consumer, stream, site) (increase(chat_nats_terminal_failures_total{reason=\"max_deliver\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} \u00b7 {{consumer}} \u00b7 {{stream}}/{{site}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Terminal failures by reason (rate)",
      "description": "rate() of chat_nats_terminal_failures_total across every reason (max_deliver / permanent / publish_exhausted / stream_unavailable / invalid_payload / catch-all). Where work stops getting further attempts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(chat_nats_terminal_failures_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Redelivery rate (chat_nats_consumer_redeliveries_total)",
      "description": "rate() of the cumulative redelivery counter per consumer \u2014 the historical companion to the point-in-time jetstream num_redelivered gauge. Sustained non-zero = repeated delivery attempts \u2014 a handler sending NAKs, AckWait expiring on a slow/hung handler, or a consumer crash-looping on the same message.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, consumer, stream, site) (rate(chat_nats_consumer_redeliveries_total[$__rate_interval]))",
          "legendFormat": "{{service_name}} \u00b7 {{consumer}} \u00b7 {{stream}}/{{site}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer disposition mix (rate by outcome)",
      "description": "rate() of chat_nats_consumer_messages_total by outcome (ack / nak / term / left_pending / handler_cancelled). A rising nak/term share precedes a backlog.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(chat_nats_consumer_messages_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrape health \u2014 target up (0 = crashed / unreachable)",
      "description": "up per scrape target for the app-metrics + jetstream-exporter jobs. A target dropping to 0 = the whole process/pod crashed or is unreachable. NOTE this is TARGET-level: it will NOT catch a single durable whose chat_nats_consumer_loop_up series disappears while sibling consumers keep the process alive (up stays 1). Per-durable liveness needs an inventory-backed alert rule \u2014 a label-scoped absent(chat_nats_consumer_loop_up{service_name,site,stream,consumer}) per expected durable \u2014 which belongs in the alerting layer (a maintained expected-durable list), not this dev dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=~\"chat-app-metrics|nats-jetstream\"}",
          "legendFormat": "{{job}} \u00b7 {{instance}}"
        }
      ]
    }
  ],
