{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "runId",
    "siteId",
    "image",
    "existingSecret",
    "mongo",
    "cassandra",
    "metrics",
    "ledger",
    "recipientObserver",
    "searchObserver",
    "encryptionPreflight",
    "seed",
    "soak",
    "teardown",
    "profiling",
    "runtime"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "enum": ["seed", "soak", "stopped", "teardown"]
    },
    "runId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "siteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "tag", "pullPolicy", "allowMutableTag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-fA-F0-9]{64})$"
        },
        "tag": {"type": "string"},
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "allowMutableTag": {"type": "boolean"}
      }
    },
    "existingSecret": {"type": "string", "minLength": 1},
    "mongo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database"],
      "properties": {
        "database": {"type": "string", "minLength": 1}
      }
    },
    "cassandra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyspace",
        "cleanup",
        "confirmKeyspace",
        "messageBucketHours"
      ],
      "properties": {
        "keyspace": {"type": "string", "minLength": 1},
        "cleanup": {"type": "string", "enum": ["none", "truncate"]},
        "confirmKeyspace": {"type": "string"},
        "messageBucketHours": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "serviceAnnotations"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "serviceAnnotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingClaim",
        "storageClassName",
        "accessMode",
        "size",
        "mountPath",
        "capacity",
        "compactEvery",
        "maxBytes",
        "expireBatch",
        "reconcileDeadline",
        "reconcileRetryInterval",
        "reconcileReadShare",
        "epoch",
        "roomReconcileReadShare"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClassName": {"type": "string"},
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteOncePod"]
        },
        "size": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"},
        "capacity": {"type": "string", "minLength": 1},
        "compactEvery": {"type": "string", "minLength": 1},
        "maxBytes": {"type": "string", "minLength": 1},
        "expireBatch": {"type": "string", "minLength": 1},
        "reconcileDeadline": {"type": "string", "minLength": 1},
        "reconcileRetryInterval": {"type": "string", "minLength": 1},
        "reconcileReadShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "epoch": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "roomReconcileReadShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "searchObserver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "encryptionPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timeout"],
      "properties": {
        "enabled": {"type": "boolean"},
        "timeout": {"type": "string", "minLength": 1}
      }
    },
    "recipientObserver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "queue",
        "connections"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "queue": {"type": "integer", "minimum": 1, "maximum": 65536},
        "connections": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    },
    "profiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pprofAddr",
        "heapProfileDir",
        "heapProfileInterval",
        "heapProfileKeep"
      ],
      "properties": {
        "pprofAddr": {"type": "string"},
        "heapProfileDir": {"type": "string"},
        "heapProfileInterval": {"type": "string", "minLength": 1},
        "heapProfileKeep": {"type": ["integer", "string"]}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goMemLimit", "goGC"],
      "properties": {
        "goMemLimit": {"type": "string"},
        "goGC": {"type": ["string", "integer"]}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "randomSeed",
        "activeDeadlineSeconds",
        "backoffLimit",
        "resources"
      ],
      "properties": {
        "randomSeed": {"type": "integer"},
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "backoffLimit": {"type": "integer", "minimum": 0},
        "resources": {"type": "object"}
      }
    },
    "soak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "runMode",
        "randomSeed",
        "warmup",
        "heartbeatInterval",
        "heartbeatStaleAfter",
        "terminationGracePeriodSeconds",
        "maxInFlight",
        "sendRate",
        "readRate",
        "threadShare",
        "mutationRate",
        "softDeleteRatio",
        "reactionRate",
        "reactionsPerHotMessage",
        "reactionMessageScope",
        "reactionRemoveShare",
        "pinnedListRate",
        "verifyRate",
        "memberMutationRate",
        "roomMutationRate",
        "roomReadRate",
        "userReadRate",
        "subscriptionListLimit",
        "subscriptionListIncludeLastMessage",
        "roomZipfS",
        "roomZipfV",
        "searchReadRate",
        "searchSettle",
        "roomCreateRate",
        "roomCreateBudget",
        "roomCreateSize",
        "readReceiptRate",
        "presenceRate",
        "presenceConnections",
        "presenceQueryShare",
        "presenceQueryBatch",
        "presenceSettle",
        "presenceTTL",
        "memberQuarantineMax",
        "maxUsers",
        "activeUsers",
        "roomCount",
        "channelRatio",
        "channelMembers",
        "largeRoomThreshold",
        "rateScope",
        "messagesPerActiveUserPerDay",
        "payloadMedianBytes",
        "payloadP95Bytes",
        "payloadMaxBytes",
        "persistGrace",
        "mutationRetries",
        "retryMinBackoff",
        "retryMaxBackoff",
        "recentPerRoom",
        "recentTotal",
        "resources"
      ],
      "properties": {
        "environment": {"type": "string", "enum": ["local", "test", "staging", "production"]},
        "runMode": {"type": "string", "enum": ["continuous"]},
        "randomSeed": {"type": "integer"},
        "warmup": {"type": "string", "minLength": 1},
        "heartbeatInterval": {
          "type": "string",
          "minLength": 1,
          "description": "Manifest heartbeat cadence. Loadgen requires heartbeatStaleAfter to be at least twice this interval plus 5s."
        },
        "heartbeatStaleAfter": {
          "type": "string",
          "minLength": 1,
          "description": "Active-run destructive-operation lease. Must be at least 2 * heartbeatInterval + 5s and longer than the planned Mongo outage and recovery window."
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxInFlight": {"type": "integer", "minimum": 1},
        "sendRate": {"type": "string", "minLength": 1},
        "readRate": {"type": "string", "minLength": 1},
        "threadShare": {"type": "string", "minLength": 1},
        "mutationRate": {"type": "string", "minLength": 1},
        "softDeleteRatio": {"type": "string", "minLength": 1},
        "reactionRate": {"type": "string", "minLength": 1},
        "reactionsPerHotMessage": {"type": "string", "minLength": 1},
        "reactionMessageScope": {
          "type": "string",
          "enum": ["hot_only", "all_messages"]
        },
        "reactionRemoveShare": {"type": "string", "minLength": 1},
        "pinnedListRate": {"type": "string", "minLength": 1},
        "verifyRate": {"type": "string", "minLength": 1},
        "memberMutationRate": {"type": "string", "minLength": 1},
        "roomMutationRate": {"type": "string", "minLength": 1},
        "roomReadRate": {"type": "string", "minLength": 1},
        "userReadRate": {"type": "string", "minLength": 1},
        "subscriptionListLimit": {"type": "string", "pattern": "^([0-9]+)?$"},
        "subscriptionListIncludeLastMessage": {"type": "string", "enum": ["", "true", "false"]},
        "roomZipfS": {
          "type": "string",
          "description": "Zipf exponent. Must be greater than 1; empty leaves the Go default (1.2). math/rand returns a nil generator at or below 1, so a value Helm accepted but the runtime rejects would only surface as a crash-looping pod.",
          "anyOf": [
            {"const": ""},
            {"pattern": "^([2-9][0-9]*|[1-9][0-9]+)(\\.[0-9]+)?$"},
            {"pattern": "^1\\.[0-9]*[1-9][0-9]*$"}
          ]
        },
        "roomZipfV": {
          "type": "string",
          "description": "Zipf offset. Must be at least 1; empty leaves the Go default (1.0). Larger flattens the room distribution.",
          "anyOf": [
            {"const": ""},
            {"pattern": "^[1-9][0-9]*(\\.[0-9]+)?$"}
          ]
        },
        "searchReadRate": {"type": "string", "minLength": 1},
        "searchSettle": {"type": "string", "minLength": 1},
        "roomCreateRate": {"type": "string", "minLength": 1},
        "roomCreateBudget": {"type": "string", "minLength": 1},
        "roomCreateSize": {"type": "string", "minLength": 1},
        "readReceiptRate": {"type": "string", "minLength": 1},
        "presenceRate": {"type": "string", "minLength": 1},
        "presenceConnections": {"type": "string", "minLength": 1},
        "presenceQueryShare": {"type": "string", "minLength": 1},
        "presenceQueryBatch": {"type": "string", "minLength": 1},
        "presenceSettle": {"type": "string", "minLength": 1},
        "presenceTTL": {"type": "string", "minLength": 1},
        "memberQuarantineMax": {"type": "string", "minLength": 1},
        "maxUsers": {"type": "string", "minLength": 1},
        "activeUsers": {"type": "string", "minLength": 1},
        "roomCount": {"type": "string", "minLength": 1},
        "channelRatio": {"type": "string", "minLength": 1},
        "channelMembers": {"type": "string", "minLength": 1},
        "largeRoomThreshold": {"type": "string", "minLength": 1},
        "rateScope": {"type": "string", "enum": ["site", "global"]},
        "messagesPerActiveUserPerDay": {"type": "string", "minLength": 1},
        "payloadMedianBytes": {"type": "string", "minLength": 1},
        "payloadP95Bytes": {"type": "string", "minLength": 1},
        "payloadMaxBytes": {"type": "string", "minLength": 1},
        "persistGrace": {"type": "string", "minLength": 1},
        "mutationRetries": {"type": "string", "minLength": 1},
        "retryMinBackoff": {"type": "string", "minLength": 1},
        "retryMaxBackoff": {"type": "string", "minLength": 1},
        "recentPerRoom": {"type": "string", "minLength": 1},
        "recentTotal": {"type": "string", "minLength": 1},
        "resources": {"type": "object"}
      }
    },
    "teardown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "batchRooms",
        "batchDelay",
        "batchTimeout",
        "activeDeadlineSeconds",
        "backoffLimit",
        "resources"
      ],
      "properties": {
        "approved": {"type": "boolean"},
        "batchRooms": {"type": "string", "minLength": 1},
        "batchDelay": {"type": "string", "minLength": 1},
        "batchTimeout": {"type": "string", "minLength": 1},
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "backoffLimit": {"type": "integer", "minimum": 0},
        "resources": {"type": "object"}
      }
    }
  }
}
