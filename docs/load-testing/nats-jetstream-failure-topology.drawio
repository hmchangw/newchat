          <mxGeometry x="270" y="235" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="canonical" value="&lt;b&gt;MESSAGES_CANONICAL&lt;/b&gt;&lt;br&gt;user / bot / Teams lanes&lt;br&gt;&lt;font color=&quot;#9A6700&quot;&gt;loadgen: partial&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=13;" vertex="1" parent="cluster">
