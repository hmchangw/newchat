        <mxCell id="title" value="NATS / JetStream Failure Testing: Traffic, Fault Injection, and Outcome Validation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Green: covered by loadgen   Yellow: partial coverage   Red: uncovered or high risk   Blue: NATS infrastructure" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="30" y="62" width="920" height="28" as="geometry" />
        </mxCell>

        <mxCell id="loadgen" value="&lt;b&gt;loadgen&lt;/b&gt;&lt;br&gt;daily + soak + presence + members&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Partial ledger: Cassandra soak message sends only; cross-site and push/search/bot observers missing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fault" value="&lt;b&gt;External Fault Injector&lt;/b&gt;&lt;br&gt;node kill / partition / quorum loss&lt;br&gt;disk pressure / consumer delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="210" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cluster" value="Production-like NATS supercluster (at least 3 nodes per site; JetStream replicas match production)" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#EAF2F8;strokeColor=#6C8EBF;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1">
